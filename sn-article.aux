\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Onset latencies of value, chosen-value-related and choice signals.} Complementary onset-latency distributions, fractions of valid resampling iterations and value-versus-choice comparisons for ACC, DLPFC and OFC.}}{36}{figure.S10}\protected@file@percent }
\newlabel{fig:supp_value_latency}{{10}{36}{\textbf {Onset latencies of value, chosen-value-related and choice signals.} Complementary onset-latency distributions, fractions of valid resampling iterations and value-versus-choice comparisons for ACC, DLPFC and OFC}{figure.S10}{}}
