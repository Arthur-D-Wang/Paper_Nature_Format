\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Behavioral-model validation and decision time.} \textbf  {(A) Out-of-sample model comparison.} Leave-one-session-out cross-validation compared the free-$\alpha $ utility model with a nested fixed-$\alpha $ model in which $\alpha =1$. The ordinate shows the held-out loss difference, $\Delta L=L_\mathrm  {fixed}-L_\mathrm  {free}$, expressed as average negative log-likelihood per trial; positive values indicate better prediction by the free-$\alpha $ model. Violin plots show loss differences across held-out sessions, and black points and vertical lines denote the median and interquartile range, respectively. The free-$\alpha $ model had lower held-out loss in all three subjects (monkey W: $n=52$ sessions, $p=4.2\times 10^{-10}$; monkey U: $n=63$, $p=7.2\times 10^{-12}$; monkey T: $n=64$, $p=3.5\times 10^{-12}$; two-sided Wilcoxon signed-rank tests against zero). \textbf  {(B) Session-wise utility curvature.} The free-$\alpha $ model was fitted independently to each session. Histograms show the distributions of the resulting $\alpha $ estimates for monkeys W, U and T (bin width, 0.05); blue dashed lines mark the medians (W, 0.73; U, 0.81; T, 0.79). Estimates below 1 correspond to diminishing marginal utility. \textbf  {(C) Observed and model-predicted choice patterns.} Rows show monkeys W, U and T. Observed earning proportions (left) and proportions predicted by the subject-level parametric model (right) are plotted as a function of token holdings for each of the 12 offer conditions. Colors follow the offer-condition convention in Fig.~\ref {fig:behavior}B,C. \textbf  {(D) Decision difficulty and reaction time.} Trials were divided within subject at the median $|\Delta V|$ into easy (larger $|\Delta V|$; orange) and hard (smaller $|\Delta V|$; blue) groups. Histograms show reaction-time distributions, and vertical lines mark group medians. Responses were longer for hard than for easy trials in each subject (W, $p=1.3\times 10^{-191}$; U, $p$ below numerical precision; T, $p=4.8\times 10^{-223}$; Wilcoxon rank-sum tests).}}{26}{figure.S1}\protected@file@percent }
\newlabel{fig:supp_behavior_summary}{{1}{26}{\textbf {Behavioral-model validation and decision time.} \textbf {(A) Out-of-sample model comparison.} Leave-one-session-out cross-validation compared the free-$\alpha $ utility model with a nested fixed-$\alpha $ model in which $\alpha =1$. The ordinate shows the held-out loss difference, $\Delta L=L_\mathrm {fixed}-L_\mathrm {free}$, expressed as average negative log-likelihood per trial; positive values indicate better prediction by the free-$\alpha $ model. Violin plots show loss differences across held-out sessions, and black points and vertical lines denote the median and interquartile range, respectively. The free-$\alpha $ model had lower held-out loss in all three subjects (monkey W: $n=52$ sessions, $p=4.2\times 10^{-10}$; monkey U: $n=63$, $p=7.2\times 10^{-12}$; monkey T: $n=64$, $p=3.5\times 10^{-12}$; two-sided Wilcoxon signed-rank tests against zero). \textbf {(B) Session-wise utility curvature.} The free-$\alpha $ model was fitted independently to each session. Histograms show the distributions of the resulting $\alpha $ estimates for monkeys W, U and T (bin width, 0.05); blue dashed lines mark the medians (W, 0.73; U, 0.81; T, 0.79). Estimates below 1 correspond to diminishing marginal utility. \textbf {(C) Observed and model-predicted choice patterns.} Rows show monkeys W, U and T. Observed earning proportions (left) and proportions predicted by the subject-level parametric model (right) are plotted as a function of token holdings for each of the 12 offer conditions. Colors follow the offer-condition convention in Fig.~\ref {fig:behavior}B,C. \textbf {(D) Decision difficulty and reaction time.} Trials were divided within subject at the median $|\Delta V|$ into easy (larger $|\Delta V|$; orange) and hard (smaller $|\Delta V|$; blue) groups. Histograms show reaction-time distributions, and vertical lines mark group medians. Responses were longer for hard than for easy trials in each subject (W, $p=1.3\times 10^{-191}$; U, $p$ below numerical precision; T, $p=4.8\times 10^{-223}$; Wilcoxon rank-sum tests)}{figure.S1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Recording-site localization and recorded-unit counts.} Coronal structural MR images show recording sites in monkeys W (left hemisphere), U (right hemisphere) and T (left hemisphere). Sections are arranged by anterior--posterior (AP) coordinate relative to ear-bar zero, with the AP range (mm) indicated at left. Colored rectangles mark recording sites assigned to ACC (red; approximately BA~24), DLPFC (green; approximately BA~46) and OFC (blue; approximately BA~11). Each site was sampled with a 16-channel Plexon S-Probe whose recording contacts were spaced 100~$\mu $m apart and spanned 1.5~mm along the probe shaft. Rectangles are shown with a length of approximately 2~mm along the probe axis, slightly greater than the contact span, to accommodate possible electrode drift and localization uncertainty. Sites sampled in multiple sessions are shown once. Cyan arrows identify the principal, medial orbital, lateral orbital and cingulate sulci. In total, 679 ACC units were recorded (monkey W, 247; monkey T, 432; no ACC recordings in monkey U), 1,056 DLPFC units (W, 127; U, 491; T, 438) and 903 OFC units (W, 111; U, 446; T, 346).}}{27}{figure.S2}\protected@file@percent }
\newlabel{fig:supp_recording_sites}{{2}{27}{\textbf {Recording-site localization and recorded-unit counts.} Coronal structural MR images show recording sites in monkeys W (left hemisphere), U (right hemisphere) and T (left hemisphere). Sections are arranged by anterior--posterior (AP) coordinate relative to ear-bar zero, with the AP range (mm) indicated at left. Colored rectangles mark recording sites assigned to ACC (red; approximately BA~24), DLPFC (green; approximately BA~46) and OFC (blue; approximately BA~11). Each site was sampled with a 16-channel Plexon S-Probe whose recording contacts were spaced 100~$\mu $m apart and spanned 1.5~mm along the probe shaft. Rectangles are shown with a length of approximately 2~mm along the probe axis, slightly greater than the contact span, to accommodate possible electrode drift and localization uncertainty. Sites sampled in multiple sessions are shown once. Cyan arrows identify the principal, medial orbital, lateral orbital and cingulate sulci. In total, 679 ACC units were recorded (monkey W, 247; monkey T, 432; no ACC recordings in monkey U), 1,056 DLPFC units (W, 127; U, 491; T, 438) and 903 OFC units (W, 111; U, 446; T, 346)}{figure.S2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Individual-animal resource-state tuning and shuffle controls.} \textbf  {(A) Preferred resource-state distributions in individual monkeys.} Bars show the percentage of selective neurons preferring each resource-state group in monkeys Will (top), Umi (middle) and Turing (bottom). Red, green and blue denote ACC, DLPFC and OFC, respectively; dark bars show shuffle estimates. No ACC recordings were obtained in Umi. \textbf  {(B) Token-holding-label shuffle control for population tuning.} Normalized population tuning curves after resource-state-group labels were shuffled and the complete unit-selection, preferred-group assignment, normalization and peak-recentering procedure was repeated. Rows show ACC, DLPFC and OFC; left panels group curves by their assigned preferred resource state, and right panels show the same curves re-centered on that state. Error bars denote SEM. Unlike the observed profiles in Fig.~\ref {fig:resource_state_tuning}F--K, the shuffled profiles showed no graded decline away from the aligned peak (ACC, $p=0.934$; DLPFC, $p=0.792$; OFC, $p=0.816$; Wilcoxon rank-sum tests). In the individual-animal analyses of the observed tuning profiles, normalized firing rates were higher at relative distances of $\pm 1$ than at $\pm 2$ in every recorded region (Will: ACC, $p=6.89\times 10^{-37}$; DLPFC, $p=1.89\times 10^{-24}$; OFC, $p=1.59\times 10^{-28}$; Umi: ACC, not available; DLPFC, $p=4.71\times 10^{-10}$; OFC, $p=5.67\times 10^{-8}$; Turing: ACC, $p=8.86\times 10^{-7}$; DLPFC, $p=5.38\times 10^{-5}$; OFC, $p=5.46\times 10^{-4}$; Wilcoxon rank-sum tests).}}{28}{figure.S3}\protected@file@percent }
\newlabel{fig:supp_resource_tuning}{{3}{28}{\textbf {Individual-animal resource-state tuning and shuffle controls.} \textbf {(A) Preferred resource-state distributions in individual monkeys.} Bars show the percentage of selective neurons preferring each resource-state group in monkeys Will (top), Umi (middle) and Turing (bottom). Red, green and blue denote ACC, DLPFC and OFC, respectively; dark bars show shuffle estimates. No ACC recordings were obtained in Umi. \textbf {(B) Token-holding-label shuffle control for population tuning.} Normalized population tuning curves after resource-state-group labels were shuffled and the complete unit-selection, preferred-group assignment, normalization and peak-recentering procedure was repeated. Rows show ACC, DLPFC and OFC; left panels group curves by their assigned preferred resource state, and right panels show the same curves re-centered on that state. Error bars denote SEM. Unlike the observed profiles in Fig.~\ref {fig:resource_state_tuning}F--K, the shuffled profiles showed no graded decline away from the aligned peak (ACC, $p=0.934$; DLPFC, $p=0.792$; OFC, $p=0.816$; Wilcoxon rank-sum tests). In the individual-animal analyses of the observed tuning profiles, normalized firing rates were higher at relative distances of $\pm 1$ than at $\pm 2$ in every recorded region (Will: ACC, $p=6.89\times 10^{-37}$; DLPFC, $p=1.89\times 10^{-24}$; OFC, $p=1.59\times 10^{-28}$; Umi: ACC, not available; DLPFC, $p=4.71\times 10^{-10}$; OFC, $p=5.67\times 10^{-8}$; Turing: ACC, $p=8.86\times 10^{-7}$; DLPFC, $p=5.38\times 10^{-5}$; OFC, $p=5.46\times 10^{-4}$; Wilcoxon rank-sum tests)}{figure.S3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Cross-temporal resource-state representations in individual animals.} Rows show Monkeys W, U and T, and columns show ACC, DLPFC and OFC; ACC was not recorded in Monkey U. Within each animal--region panel, the upper-left matrix shows offer-onset-aligned decoding (14 50-ms bins, $-200$ to $500$~ms) and the lower-right matrix shows wallet-update-aligned decoding (10 50-ms bins, $-200$ to $300$~ms). Each entry is the mean cross-validated $R^2$ obtained by fitting a TDR-derived resource-state axis at the training time and applying it at the test time. Horizontal and vertical dashed lines mark the corresponding event onset. Black entries did not significantly exceed the resource-state-label-shuffled control (paired one-sided Wilcoxon signed-rank test, $p>0.05$ across matched resampling iterations).}}{29}{figure.S4}\protected@file@percent }
\newlabel{fig:supp_cross_temporal}{{4}{29}{\textbf {Cross-temporal resource-state representations in individual animals.} Rows show Monkeys W, U and T, and columns show ACC, DLPFC and OFC; ACC was not recorded in Monkey U. Within each animal--region panel, the upper-left matrix shows offer-onset-aligned decoding (14 50-ms bins, $-200$ to $500$~ms) and the lower-right matrix shows wallet-update-aligned decoding (10 50-ms bins, $-200$ to $300$~ms). Each entry is the mean cross-validated $R^2$ obtained by fitting a TDR-derived resource-state axis at the training time and applying it at the test time. Horizontal and vertical dashed lines mark the corresponding event onset. Black entries did not significantly exceed the resource-state-label-shuffled control (paired one-sided Wilcoxon signed-rank test, $p>0.05$ across matched resampling iterations)}{figure.S4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Individual-animal and label-shuffle tests of choice-dependent resource-state updating.} The temporal coefficient of the resource-state-axis projection was tested against zero using one-sided Wilcoxon signed-rank tests: $p_E$ is right-tailed for a positive earning coefficient and $p_S$ is left-tailed for a negative spending coefficient. Significant $p$ values ($p<0.05$) are shown in bold and colored red for $p_E$ or green for $p_S$; non-significant values remain black. Bidirectional updating was defined a priori as $p_E<0.05$ and $p_S<0.05$. No ACC recordings were available for Monkey U. Although an isolated direction reached $p<0.05$ in each shuffle control, neither shuffle produced bidirectional updating in any region.}}{30}{table.S1}\protected@file@percent }
\newlabel{tab:supp_state_updating}{{1}{30}{\textbf {Individual-animal and label-shuffle tests of choice-dependent resource-state updating.} The temporal coefficient of the resource-state-axis projection was tested against zero using one-sided Wilcoxon signed-rank tests: $p_E$ is right-tailed for a positive earning coefficient and $p_S$ is left-tailed for a negative spending coefficient. Significant $p$ values ($p<0.05$) are shown in bold and colored red for $p_E$ or green for $p_S$; non-significant values remain black. Bidirectional updating was defined a priori as $p_E<0.05$ and $p_S<0.05$. No ACC recordings were available for Monkey U. Although an isolated direction reached $p<0.05$ in each shuffle control, neither shuffle produced bidirectional updating in any region}{table.S1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Single-unit evidence for resource-state modulation of offer-value encoding.} \textbf  {(A--B) Representative OFC neurons.} Mean firing rates are plotted across the five token-holding groups for the three earning rates (A; red) or the three non-zero spending reward magnitudes (B; green); darker shades denote higher offer values and error bars denote SEM. Earning-related firing was lower, whereas spending-related firing was higher, at high than at low resource states. \textbf  {(C) Joint encoding of offer value and resource state.} Matrices show the proportions of units classified by the signs of their state-independent offer-value and token-holding coefficients in ACC, DLPFC and OFC. The upper row shows earning value ($V_E$) and the lower row spending value ($V_S$). The predicted same-sign association between $V_S$ and token holdings was significant in all three regions, whereas the predicted opposite-sign association between $V_E$ and token holdings was not (Fisher's exact tests; see Methods). \textbf  {(D) Resource-dependent earning-value model comparison in individual animals.} Solid lines show the across-unit mean increase in explained variance from $M_1$ to $M_2$ around wallet update for monkeys W, U and T; shading denotes $\pm $SEM. Red, green and blue denote ACC, DLPFC and OFC, respectively, and dashed lines show value-label-shuffled controls. Colored triangles denote time bins in which the observed $\Delta R^2_{\mathrm  {adj}}$ differed from the corresponding shuffled control ($p<0.05$, two-sided Wilcoxon signed-rank test). The vertical dashed line marks wallet update.}}{31}{figure.S5}\protected@file@percent }
\newlabel{fig:supp_offer_value_single_unit}{{5}{31}{\textbf {Single-unit evidence for resource-state modulation of offer-value encoding.} \textbf {(A--B) Representative OFC neurons.} Mean firing rates are plotted across the five token-holding groups for the three earning rates (A; red) or the three non-zero spending reward magnitudes (B; green); darker shades denote higher offer values and error bars denote SEM. Earning-related firing was lower, whereas spending-related firing was higher, at high than at low resource states. \textbf {(C) Joint encoding of offer value and resource state.} Matrices show the proportions of units classified by the signs of their state-independent offer-value and token-holding coefficients in ACC, DLPFC and OFC. The upper row shows earning value ($V_E$) and the lower row spending value ($V_S$). The predicted same-sign association between $V_S$ and token holdings was significant in all three regions, whereas the predicted opposite-sign association between $V_E$ and token holdings was not (Fisher's exact tests; see Methods). \textbf {(D) Resource-dependent earning-value model comparison in individual animals.} Solid lines show the across-unit mean increase in explained variance from $M_1$ to $M_2$ around wallet update for monkeys W, U and T; shading denotes $\pm $SEM. Red, green and blue denote ACC, DLPFC and OFC, respectively, and dashed lines show value-label-shuffled controls. Colored triangles denote time bins in which the observed $\Delta R^2_{\mathrm {adj}}$ differed from the corresponding shuffled control ($p<0.05$, two-sided Wilcoxon signed-rank test). The vertical dashed line marks wallet update}{figure.S5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Components, controls and individual-animal results for population value-space geometry.} The three columns on the left show the aspect ratio $R_S/R_E$ for ACC, DLPFC and OFC; the three columns on the right show its component earning-axis (red solid) and spending-axis (green dashed) ranges. Columns within each panel denote low, middle and high resource states; points and error bars show the mean $\pm $SD across bootstrap resamples. The red dotted line in the aspect-ratio panels marks equality between the two component ranges. Rows show the pooled population, the complete analysis after shuffling resource-state labels, the complete analysis after shuffling value labels, and the corresponding results for monkeys W, U and T. ACC panels are blank for monkey U because no ACC recordings were obtained from this animal. Resource-state shuffling attenuated state-related variation in the geometry, whereas value-label shuffling collapsed both component ranges and reduced the aspect ratio towards 1.}}{32}{figure.S6}\protected@file@percent }
\newlabel{fig:supp_offer_value_geometry}{{6}{32}{\textbf {Components, controls and individual-animal results for population value-space geometry.} The three columns on the left show the aspect ratio $R_S/R_E$ for ACC, DLPFC and OFC; the three columns on the right show its component earning-axis (red solid) and spending-axis (green dashed) ranges. Columns within each panel denote low, middle and high resource states; points and error bars show the mean $\pm $SD across bootstrap resamples. The red dotted line in the aspect-ratio panels marks equality between the two component ranges. Rows show the pooled population, the complete analysis after shuffling resource-state labels, the complete analysis after shuffling value labels, and the corresponding results for monkeys W, U and T. ACC panels are blank for monkey U because no ACC recordings were obtained from this animal. Resource-state shuffling attenuated state-related variation in the geometry, whereas value-label shuffling collapsed both component ranges and reduced the aspect ratio towards 1}{figure.S6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Single-unit test of value-difference encoding.} Joint $V_E$--$V_S$ coefficient-sign matrices, anti-diagonal enrichment tests, individual-animal results and shuffle controls.}}{33}{figure.S7}\protected@file@percent }
\newlabel{fig:supp_delta_value}{{7}{33}{\textbf {Single-unit test of value-difference encoding.} Joint $V_E$--$V_S$ coefficient-sign matrices, anti-diagonal enrichment tests, individual-animal results and shuffle controls}{figure.S7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Summary of value and choice encoding across prefrontal regions.} Single-unit encoding proportions for $V_E$, $V_S$, $V_{\mathrm  {Chosen}}$, categorical choice and token holdings, including chance estimates, unit counts and individual-animal results.}}{34}{figure.S8}\protected@file@percent }
\newlabel{fig:supp_value_summary}{{8}{34}{\textbf {Summary of value and choice encoding across prefrontal regions.} Single-unit encoding proportions for $V_E$, $V_S$, $V_{\mathrm {Chosen}}$, categorical choice and token holdings, including chance estimates, unit counts and individual-animal results}{figure.S8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Controls for choice-conditioned value encoding.} Complete interaction-contrast statistics, individual-animal results, trial-count matching and label-shuffle controls for the choice-conditioned TDR analysis.}}{35}{figure.S9}\protected@file@percent }
