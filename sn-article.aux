\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}Prefrontal encoding of chosen value during resource-state-dependent decisions}{8}{subsection.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Prefrontal encoding of chosen value during resource-state-dependent decisions.} \textbf  {(A--B) Representative unit with choice-dependent value tuning.} Mean firing rate is plotted against the resource-state-dependent earning value ($V_E$; A) and spending value ($V_S$; B), separately for earning (solid lines) and spending (dashed lines) choices. Red and green denote $V_E$ and $V_S$, respectively. For $V_E$, tuning was positive under both choices but steeper during earning choices. For $V_S$, tuning was positive during spending choices and negative during earning choices. Error bars denote SEM. This unit is shown as an illustrative example; no separate significance criterion was applied to these tuning curves. \textbf  {(C--F) Choice-conditioned population value encoding.} TDR was performed separately within earning (C,D) and spending (E,F) trial pools. Encoding strength ($R^2$) is shown for $V_E$ (C,E) and $V_S$ (D,F); red, green and blue denote ACC, DLPFC and OFC, respectively, and shading denotes $\pm $SD across 100 bootstrap iterations. Choice-dependent value encoding was quantified by the interaction contrast $D=[R^2(V_E\mid \mathrm  {Earn})-R^2(V_S\mid \mathrm  {Earn})]-[R^2(V_E\mid \mathrm  {Spend})-R^2(V_S\mid \mathrm  {Spend})]$. \textbf  {[TODO: report the predefined analysis window, effect size, test statistic and $p$ value for each region.] }\textbf  {(G--I) Population encoding dynamics.} TDR was performed separately for $V_E$, $V_S$, $V_{\mathrm  {Chosen}}$ and categorical choice. Encoding strength $R^2(t)$ is shown for ACC (G), DLPFC (H) and OFC (I); shading denotes $\pm $SD across 100 bootstrap iterations. \textbf  {(J--L) Half-peak latency.} For each $R^2(t)$ trajectory, $t_{50}$ was defined as the first time point in $[0,T_{\mathrm  {peak}}]$ at which $R^2$ exceeded the midpoint between the pre-stimulus baseline median and the peak value, provided that the peak exceeded the 95th percentile of the baseline distribution. Violin plots show the $t_{50}$ distributions across 100 bootstrap iterations for ACC (J), DLPFC (K) and OFC (L); violin area is proportional to the fraction of iterations yielding a valid estimate. Points and horizontal lines denote the median and interquartile range. P values are from pairwise two-sided Wilcoxon rank-sum tests comparing each value variable with the choice signal.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:chosen_value}{{5}{9}{\textbf {Prefrontal encoding of chosen value during resource-state-dependent decisions.} \textbf {(A--B) Representative unit with choice-dependent value tuning.} Mean firing rate is plotted against the resource-state-dependent earning value ($V_E$; A) and spending value ($V_S$; B), separately for earning (solid lines) and spending (dashed lines) choices. Red and green denote $V_E$ and $V_S$, respectively. For $V_E$, tuning was positive under both choices but steeper during earning choices. For $V_S$, tuning was positive during spending choices and negative during earning choices. Error bars denote SEM. This unit is shown as an illustrative example; no separate significance criterion was applied to these tuning curves. \textbf {(C--F) Choice-conditioned population value encoding.} TDR was performed separately within earning (C,D) and spending (E,F) trial pools. Encoding strength ($R^2$) is shown for $V_E$ (C,E) and $V_S$ (D,F); red, green and blue denote ACC, DLPFC and OFC, respectively, and shading denotes $\pm $SD across 100 bootstrap iterations. Choice-dependent value encoding was quantified by the interaction contrast $D=[R^2(V_E\mid \mathrm {Earn})-R^2(V_S\mid \mathrm {Earn})]-[R^2(V_E\mid \mathrm {Spend})-R^2(V_S\mid \mathrm {Spend})]$. \textbf {[TODO: report the predefined analysis window, effect size, test statistic and $p$ value for each region.] }\textbf {(G--I) Population encoding dynamics.} TDR was performed separately for $V_E$, $V_S$, $V_{\mathrm {Chosen}}$ and categorical choice. Encoding strength $R^2(t)$ is shown for ACC (G), DLPFC (H) and OFC (I); shading denotes $\pm $SD across 100 bootstrap iterations. \textbf {(J--L) Half-peak latency.} For each $R^2(t)$ trajectory, $t_{50}$ was defined as the first time point in $[0,T_{\mathrm {peak}}]$ at which $R^2$ exceeded the midpoint between the pre-stimulus baseline median and the peak value, provided that the peak exceeded the 95th percentile of the baseline distribution. Violin plots show the $t_{50}$ distributions across 100 bootstrap iterations for ACC (J), DLPFC (K) and OFC (L); violin area is proportional to the fraction of iterations yielding a valid estimate. Points and horizontal lines denote the median and interquartile range. P values are from pairwise two-sided Wilcoxon rank-sum tests comparing each value variable with the choice signal}{figure.5}{}}
